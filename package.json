{
  "name": "juezhao-auth",
  "private": false,
  "version": "1.0.0",
  "description": "Juezhao Auth - TOTP/HOTP Two-Factor Authentication Client",
  "license": "Apache-2.0",
  "keywords": ["totp", "hotp", "2fa", "authentication", "security", "capacitor", "react"],
  "type": "module",
  "scripts": {
    "dev": "vite",
