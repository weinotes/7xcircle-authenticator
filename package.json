{
  "name": "7xcircle-authenticator",
  "private": false,
  "version": "1.1.0",
  "description": "7X Circle Authenticator - offline TOTP/HOTP two-factor authentication client for the 7X Circle club",
  "license": "Apache-2.0",
  "author": "Davey Wong <wgwcko@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7xcircle/authenticator.git"
  },
  "bugs": {
    "url": "https://github.com/7xcircle/authenticator/issues"
  },
  "homepage": "https://github.com/7xcircle/authenticator#readme",
  "keywords": ["totp", "hotp", "2fa", "authenticator", "authentication", "security", "capacitor", "react", "7x-circle"],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b",
    "cap:sync": "pnpm build && cap sync",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/barcode-scanner": "^3.0.2",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/core": "^8.4.1",
    "otpauth": "^9.5.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^24.0.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^2.0.0"
  }
}
